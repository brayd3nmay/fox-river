# Public site works with bundled content when Supabase is not configured.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set true only on the reviewed production deployment. Previews remain noindex.
SITE_INDEXABLE=false
# Optional. The HTML tag value from Google Search Console's verification screen.
GOOGLE_SITE_VERIFICATION=
